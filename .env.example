# ---- Telethon (my.telegram.org -> API development tools) ----
API_ID=1234567
API_HASH=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SESSION_NAME=userbot

# ---- Admin bot (@BotFather) ----
BOT_TOKEN=123456:AAAA-BBBB
ADMIN_ID=123456789
# Maxfiy arxiv kanali (ixtiyoriy). Kanal yarating, botni admin qiling,
# ID ni @username_to_id_bot yoki @getmyid_bot dan oling (-100... bilan boshlanadi).
LOG_CHANNEL_ID=-1001234567890

# ---- Gemini (https://aistudio.google.com/apikey) ----
# 2-3 ta bepul kalitni vergul bilan ajratib yozing — biri limitga to'lsa,
# tizim avtomatik keyingisiga o'tadi.
GEMINI_API_KEYS=AIza...key1,AIza...key2,AIza...key3
GEMINI_MODEL=gemini-3.5-flash-lite
# Fikrlash tokenlari ham shu budjetdan yeyiladi (~300-450 ta),
# shuning uchun 800 dan kam qilmang — javob o'rtasidan kesiladi.
MAX_OUTPUT_TOKENS=1000
# low | high  (Gemini 3.x uchun)
THINKING_LEVEL=low
HISTORY_LIMIT=8

# ---- Ixtiyoriy ----
REPLY_DELAY_MIN=1.0
REPLY_DELAY_MAX=2.0
